# --- Google OAuth ---
# Google Cloud Console → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the callback URL. If unset, it is derived from the request host.
# GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/auth/google/callback

# --- Session ---
# Random secret for signing session JWTs, e.g. `openssl rand -base64 32`
JWT_SECRET=

# --- Vercel Blob ---
# Auto-injected by Vercel when a Blob store is linked to the project.
# Set manually only for local `vercel dev` against a remote store.
# BLOB_READ_WRITE_TOKEN=

# --- Existing (data decrypt at build) ---
# DATA_KEY=
